<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="450"
             xmlns:vm="using:EnvTool.ViewModels"
             x:DataType="vm:MavenManagementViewModel"
             x:Class="EnvTool.Views.MavenManagementView">
    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="微软雅黑" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Width" Value="100" />
            <Setter Property="Height" Value="30" />
        </Style>
        <Style Selector="Button.back">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="5 0 0 0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Width" Value="40" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="微软雅黑" />
        </Style>
        <Style Selector="TabControl">
            <Setter Property="Margin" Value="0 0 0 10" />
        </Style>
        <Style Selector="TabControl TabItem">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="微软雅黑" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <DockPanel Dock="Top" Height="40" LastChildFill="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10 0 0 0">
                <TextBlock FontWeight="Bold" Text="{Binding CurrentVersion, StringFormat='Maven: {0}'}" />
            </StackPanel>
        </DockPanel>

        <DockPanel Dock="Bottom" Height="40" LastChildFill="False">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button Content="保存设置" Command="{Binding SaveSettingsCommand}" />
                <Button Content="刷新" Command="{Binding LoadDataCommand}" />
            </StackPanel>
        </DockPanel>

        <TabControl SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="源管理">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10" Margin="0 10 0 0">
                        <Button Content="新增" Command="{Binding ShowAddDialogCommand}" Click="OnOpenAddDialog" />
                        <Button Content="删除" Command="{Binding RemoveSourceCommand}" />
                        <Button Content="设为默认" Command="{Binding SetDefaultSourceCommand}" />
                    </StackPanel>
                    <StackPanel>
                        <Border BorderThickness="0 0 0 1" BorderBrush="Gray" Margin="0 0 0 5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="300" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ID" FontWeight="Bold" />
                                <TextBlock Grid.Column="1" Text="名称" FontWeight="Bold" />
                                <TextBlock Grid.Column="2" Text="地址" FontWeight="Bold" />
                                <TextBlock Grid.Column="3" Text="默认" FontWeight="Bold" />
                            </Grid>
                        </Border>
                        <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:MavenSourceItem">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="300" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Id}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Url}" />
                                        <TextBlock Grid.Column="3" Text="{Binding IsDefault}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </DockPanel>
            </TabItem>
            <TabItem Header="settings.xml">
                <TextBox Text="{Binding SettingsContent}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap" />
            </TabItem>
        </TabControl>
    </DockPanel>
    </UserControl>
