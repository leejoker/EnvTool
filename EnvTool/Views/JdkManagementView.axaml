<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="450"
             xmlns:vm="using:EnvTool.ViewModels"
             x:DataType="vm:JdkManagementViewModel"
             x:Class="EnvTool.Views.JdkManagementView">
    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="微软雅黑" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Width" Value="100" />
            <Setter Property="Height" Value="30" />
        </Style>
        <Style Selector="Button.back">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="5 0 0 0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Width" Value="40" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="微软雅黑" />
        </Style>
        <Style Selector="TabControl">
            <Setter Property="Margin" Value="0 0 0 10" />
        </Style>
        <Style Selector="TabControl TabItem">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="微软雅黑" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="DataGrid">
            <Setter Property="FontFamily" Value="微软雅黑" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <!-- Top: Header with back button and current version -->
        <DockPanel Dock="Top" Height="40" LastChildFill="False">
            <Button Classes="back"
                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).BackToProxyConfig}">
                &lt;
            </Button>
            <TextBlock VerticalAlignment="Center" Margin="10 0 0 0" FontWeight="Bold">
                <Run Text="Current JDK: " />
                <Run Text="{Binding CurrentVersion}" />
            </TextBlock>
        </DockPanel>

        <!-- Bottom: Action buttons -->
        <DockPanel Dock="Bottom" Height="40" LastChildFill="False">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button Content="安装" Command="{Binding InstallSelectedCommand}" IsEnabled="{Binding !IsLoading}" />
                <Button Content="切换" Command="{Binding UseSelectedCommand}" IsEnabled="{Binding !IsLoading}" />
                <Button Content="卸载" Command="{Binding RemoveSelectedCommand}" IsEnabled="{Binding !IsLoading}" />
                <Button Content="刷新" Command="{Binding RefreshInstalledCommand}" IsEnabled="{Binding !IsLoading}" />
            </StackPanel>
        </DockPanel>

        <!-- Middle: TabControl with two tabs -->
        <TabControl>
            <TabItem Header="本地版本">
                <DataGrid ItemsSource="{Binding InstalledJdks}"
                          SelectedItem="{Binding SelectedJdk}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserResizeColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="发行版" Binding="{Binding Distro}" Width="100" />
                        <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="150" />
                        <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*" />
                        <DataGridTextColumn Header="当前" Binding="{Binding IsCurrent}" Width="60" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="可安装版本">
                <DataGrid ItemsSource="{Binding AvailableJdks}"
                          SelectedItem="{Binding SelectedJdk}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserResizeColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="发行版" Binding="{Binding Distro}" Width="100" />
                        <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="150" />
                        <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>